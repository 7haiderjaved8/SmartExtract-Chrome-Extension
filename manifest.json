{
  "manifest_version": 3,
  "name": "SmartExtract - Web Product & Data Scraper",
  "version": "1.0.0",
  "description": "Professional client-side product extractor with configurable CSS selectors, live preview, and secure CSV export.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SmartExtract",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
